{
  "$schema": "https://schema.tauri.app/config/2.json",
  "productName": "OpenSharkX11",
  "version": "2.0.0",
  "identifier": "dev.clevs.opensharkx11",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "title": "OpenSharkX11",
        "width": 1200,
        "height": 860,
        "minWidth": 960,
        "minHeight": 720,
        "decorations": false,
        "backgroundColor": "#070b10",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "publisher": "Clevs",
    "homepage": "https://github.com/clevim/OpenSharkX11",
    "shortDescription": "Configurador do mouse Attack Shark X11 para Linux",
    "longDescription": "Configurador nativo para o mouse Attack Shark X11: DPI por estágio, iluminação RGB, remapeamento de botões, polling rate, debounce, perfis e nível de bateria. Funciona via dongle 2.4GHz, USB com fio e Bluetooth.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "linux": {
      "deb": {
        "depends": ["libusb-1.0-0"],
        "postInstallScript": "../scripts/postinstall-deb.sh",
        "postRemoveScript": "../scripts/postremove-deb.sh"
      }
    }
  }
}
