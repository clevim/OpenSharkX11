# Maintainer: Clevs
# AUR: opensharkx11-git — builds from GitHub main branch
pkgname=opensharkx11-git
pkgver=r1.g0000000
pkgrel=1
pkgdesc="Native Linux configurator for the Attack Shark X11 mouse"
arch=('x86_64')
url="https://github.com/clevim/OpenSharkX11"
license=('MIT')
depends=('webkit2gtk-4.1' 'libusb' 'gtk3' 'libayatana-appindicator')
makedepends=('nodejs' 'npm' 'rust' 'cargo' 'git' 'pkg-config')
provides=('opensharkx11')
conflicts=('opensharkx11')
install="opensharkx11.install"
source=("$pkgname::git+https://github.com/clevim/OpenSharkX11.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf "r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  npm install --no-audit --no-fund
}

build() {
  cd "$pkgname"
  # --no-bundle: o pacote instala o binário direto, não precisa de deb/AppImage
  npm run build -- --no-bundle
}

package() {
  cd "$pkgname"

  install -Dm755 "src-tauri/target/release/opensharkx11" \
    "${pkgdir}/usr/bin/opensharkx11"

  install -Dm644 "assets/opensharkx11.desktop" \
    "${pkgdir}/usr/share/applications/opensharkx11.desktop"
  install -Dm644 "assets/icon.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/opensharkx11.svg"
  for size in 16 24 32 48 64 128 256 512; do
    if [ -f "assets/icons/${size}x${size}.png" ]; then
      install -Dm644 "assets/icons/${size}x${size}.png" \
        "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/opensharkx11.png"
    fi
  done

  # udev rules for USB access without root
  install -Dm644 "aur/99-attack-shark-x11.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/99-attack-shark-x11.rules"
}
